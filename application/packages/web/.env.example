# Build-time variables for the web app. Vite bakes each value into the bundle,
# so none of them is a secret and every one is readable in any shipped build.
# Real secrets (Supabase service role key, Paddle API key, webhook signing
# secrets) are server-side and never appear here.
#
# Copy this file to .env.local for local development. Production values live in
# the Cloudflare dashboard under Workers & Pages > privacynotes-app > Settings >
# Build > Variables and secrets, and a copy belongs in the password manager.
#
# Warning: a local .env.local is normally a Paddle SANDBOX configuration. Never
# restore the Cloudflare variables from it. A sandbox token in production builds
# a live site whose checkout runs in test mode.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=

# 'false' in production. paddle.ts compares this against the literal 'true'.
VITE_PADDLE_SANDBOX=
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRO_PRICE_ID=
VITE_PADDLE_BETA_DISCOUNT_ID=
VITE_PADDLE_STORAGE_1GB_PRICE_ID=
VITE_PADDLE_STORAGE_2GB_PRICE_ID=
VITE_PADDLE_STORAGE_5GB_PRICE_ID=
