<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera: required for the sign-in QR scanner (getUserMedia in the webview).
         wry's RustWebChromeClient.onPermissionRequest maps VIDEO_CAPTURE to the
         runtime CAMERA permission, but Android silently auto-denies runtime
         requests for permissions not declared here - no dialog, dead camera.
         Re-add after any `tauri android init` (re-init wipes this file).
         Spec: ops/docs/android-setup.md (manifest re-apply checklist) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Microphone: required for the editor's voice recorder (getUserMedia in
         the webview). Same trap as CAMERA above, and it caught us a second time:
         wry's onPermissionRequest maps AUDIO_CAPTURE to BOTH of these, and
         Android auto-denies a runtime request naming any permission missing
         here - no dialog, dead microphone ("No requestable permission in the
         request" in logcat). Chromium wants both too: without
         MODIFY_AUDIO_SETTINGS it logs "Requires MODIFY_AUDIO_SETTINGS and
         RECORD_AUDIO. No audio device will be available for recording".
         Re-add after any `tauri android init` (re-init wipes this file).
         Spec: ops/docs/android-setup.md (manifest re-apply checklist) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.privacynotes"
        android:allowBackup="false"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- allowBackup MUST stay false. Android defaults it to true, and with
             it on, the OS copies the app's data directory into the user's cloud
             backup. For this app that directory holds the webview's storage:
             sealed note content, the wrapped recovery phrase on a trusted
             device, and the browser-held key material that opens both. A
             complete copy of that directory is the profile-copy case
             THREAT_MODEL.md treats as recoverable, so the backup would carry
             the means to open an end-to-end encrypted account into a
             third-party service the user never chose.
             Re-add after any `tauri android init` (re-init wipes this file).
             Spec: ops/docs/android-setup.md (re-apply checklist) -->
        <!-- adjustResize + the IME inset listener in MainActivity.kt keep the
             webview above the soft keyboard. Edge-to-edge disables the framework
             resize; without both pieces Android pans the page to reveal the caret
             and the app header scrolls off-screen.
             Re-add after any `tauri android init` (re-init wipes this file).
             Spec: ops/docs/android-setup.md (re-apply checklist) -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="privacynotes" />
                
                
                
                
                
            </intent-filter>
            <intent-filter android:autoVerify="true" >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="use.privacynotes.app" />
                
                
                <data android:pathPrefix="/auth/callback" />
                
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
