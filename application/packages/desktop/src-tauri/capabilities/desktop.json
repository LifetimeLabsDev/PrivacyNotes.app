        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/.ssh/**"
        },
        {
          "path": "$HOME/.gnupg/**"
        },
        {
          "path": "$HOME/.aws/**"
        },
        {
          "path": "$HOME/.kube/**"
        },
        {
          "path": "$HOME/.docker/**"
        },
        {
          "path": "$HOME/.config/gh/**"
        },
        {
          "path": "$HOME/.local/share/keyrings/**"
        }
      ]
    }
  ]
}
