{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only grants for the Markdown folder pillar, which picks a file or folder and then scans, reads, writes and renames plaintext notes inside it. Separate from default.json because the pillar reports itself unavailable on iOS and Android, so those builds were carrying grants with no feature behind them. What stayed in default.json is what `saveBlob` needs on every platform: a Save As dialog, a write, and the stat that proves the bytes landed, which Android's create-document flow makes load-bearing rather than decorative. Every grant here is scoped to $HOME, which the picker widens at runtime to whatever the user actually chose and a double-clicked file widens through take_pending_opens. The deny list is the part $HOME/** cannot express: credential directories that no notes folder is, refused whatever the allow says, because a deny always wins. `plugins.fs.requireLiteralLeadingDot` is true, so $HOME/** no longer reaches a dot-path at all: a hidden directory is covered only by a pattern that spells the dot out. The folder picker is unaffected because it widens the runtime scope with the chosen path itself, whose own pattern carries the dot when the folder is a hidden one.",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main",
    "about"
  ],
  "permissions": [
    "dialog:allow-open",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/.ssh/**"
        },
        {
          "path": "$HOME/.gnupg/**"
        },
        {
          "path": "$HOME/.aws/**"
        },
        {
          "path": "$HOME/.kube/**"
        },
        {
          "path": "$HOME/.docker/**"
        },
        {
          "path": "$HOME/.config/gh/**"
        },
        {
          "path": "$HOME/.local/share/keyrings/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/.ssh/**"
        },
        {
          "path": "$HOME/.gnupg/**"
        },
        {
          "path": "$HOME/.aws/**"
        },
        {
          "path": "$HOME/.kube/**"
        },
        {
          "path": "$HOME/.docker/**"
        },
        {
          "path": "$HOME/.config/gh/**"
        },
        {
          "path": "$HOME/.local/share/keyrings/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/.ssh/**"
        },
        {
          "path": "$HOME/.gnupg/**"
        },
        {
          "path": "$HOME/.aws/**"
        },
        {
          "path": "$HOME/.kube/**"
        },
        {
          "path": "$HOME/.docker/**"
        },
        {
          "path": "$HOME/.config/gh/**"
        },
        {
          "path": "$HOME/.local/share/keyrings/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/.ssh/**"
        },
        {
          "path": "$HOME/.gnupg/**"
        },
        {
          "path": "$HOME/.aws/**"
        },
        {
          "path": "$HOME/.kube/**"
        },
        {
          "path": "$HOME/.docker/**"
        },
        {
          "path": "$HOME/.config/gh/**"
        },
        {
          "path": "$HOME/.local/share/keyrings/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/.ssh/**"
        },
        {
          "path": "$HOME/.gnupg/**"
        },
        {
          "path": "$HOME/.aws/**"
        },
        {
          "path": "$HOME/.kube/**"
        },
        {
          "path": "$HOME/.docker/**"
        },
        {
          "path": "$HOME/.config/gh/**"
        },
        {
